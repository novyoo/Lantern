[Unit]
Description=Lantern server
After=network-online.target

[Service]
User=azureuser
WorkingDirectory=/home/azureuser/Lantern/server
EnvironmentFile=/etc/lantern.env
ExecStart=/home/azureuser/lantern-venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
